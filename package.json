{
  "name": "md-editor",
  "version": "1.1.1",
  "description": "A lightweight, modern Markdown editor with live preview",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Fupu Technology (Beijing) Co., Ltd.",
    "email": "jiuyaodijun@yeah.net"
  },
  "license": "MIT",
  "homepage": "https://github.com/zhangjianle0836-netizen/markdown-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangjianle0836-netizen/markdown-editor.git"
  },
  "bugs": {
    "url": "https://github.com/zhangjianle0836-netizen/markdown-editor/issues"
  },
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-task.cjs test",
    "test:integration": "node scripts/run-task.cjs integration",
    "typecheck": "node scripts/run-task.cjs typecheck",
    "build": "node scripts/run-task.cjs build",
    "electron:dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:3000 && node scripts/electron-dev.cjs\"",
    "electron:build": "npm run build && node scripts/run-task.cjs package",
    "electron:build:mac:arm64": "npm run build && node scripts/run-task.cjs package --mac dmg zip --arm64",
    "electron:build:mac:x64": "npm run build && node scripts/run-task.cjs package --mac dmg zip --x64",
    "electron:build:mac:universal": "npm run build && node scripts/run-task.cjs package --mac dmg zip --universal",
    "electron:build:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/run-task.cjs package --mac dmg zip",
    "preview": "vite preview",
    "lint": "npm run typecheck",
    "verify": "node scripts/run-task.cjs verify",
    "electron:package:mac:arm64": "node scripts/run-task.cjs package --mac dmg zip --arm64"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "react",
    "live-preview",
    "gfm"
  ],
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "terser": "^5.46.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "wait-on": "^7.2.0",
    "@uiw/react-md-editor": "^4.0.4",
    "dompurify": "^3.4.16",
    "marked": "^17.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.mdeditor.app",
    "productName": "MDEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "type": "distribution"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MDEditor"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ]
    },
    "electronLanguages": [
      "en-US",
      "en",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
